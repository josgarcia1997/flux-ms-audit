NODE_ENV=development
PORT=3011

# Local (Nest sin Docker): broker en tu máquina
RABBITMQ_URI=amqp://localhost:5672

# Docker Compose de este repo: usa el servicio rabbitmq (hostname flux-rabbitmq)
# RABBITMQ_URI=amqp://guest:guest@flux-rabbitmq:5672

# Si ya tienes Rabbit en el host y el contenedor no lo ve, prueba (Docker Desktop):
# RABBITMQ_URI=amqp://host.docker.internal:5672

RABBITMQ_AUDIT_QUEUE=audit_queue
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

DB_HOST=localhost
DB_PORT=5432
DB_PASSWORD=postgres
# Usuario y base: DB_USER + DB_NAME, o alias DB_USERNAME + DB_DATABASE (como receipt)
DB_USER=postgres
DB_NAME=flux_audit_db
